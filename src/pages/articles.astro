---
import { getCollection } from "astro:content";
import { calculateReadTime } from "../utils/blog";
import Layout from "../layouts/Layout.astro";

const allPosts = await getCollection("blog");

const sortedPosts = allPosts.sort((a, b) => {
	return (
		new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
	);
});

const posts = sortedPosts
	.map((post) => ({
		id: post.data.id,
		slug: post.data.slug,
		title: post.data.title,
		description: post.data.description,
		imageUrl: post.data.imageUrl,
		imageAlt: post.data.imageAlt,
		pubDate: post.data.pubDate,
		author: post.data.author,
		category: post.data.category,
		readTime: calculateReadTime(post.body),
	}))
	.slice(0, 20);

const INITIAL_COUNT = 6;
const INCREMENT = 3;
---

<Layout page="articles" title="" description="">
	<main class="wrapper">
		<div class="hero"><h1>Articles by Greg Harmeling, Psy.D., LMFT</h1></div>

		<section>
			<ul class="article-grid">
				<!-- TODO: create a component for this. -->
				{
					posts.map((post, index) => (
						<li
							class={`article-card ${index >= INITIAL_COUNT ? "is-hidden" : ""}`}
							data-index={index}
						>
							<a href={`/blog/${post.slug}`}>
								<img
									src={`/images/posts/thumb-post${post.id}.jpg`}
									alt={post.imageAlt || post.title}
									class="post-thumb"
								/>
							</a>
							<div class="post-blurb">
								{
									<p>
										{post.category}
										<br />
										{post.readTime} min read
									</p>
								}
								<h2>{post.title}</h2>
								<p>{post.description}</p>
								<p>
									{post.pubDate.toString().slice(0, 15)} <br /> {post.author}
								</p>
								<p>
									<a href={`/blog/${post.slug}`}>Read more...</a>
								</p>
							</div>
						</li>
					))
				}
			</ul>
			{
				posts.length > INITIAL_COUNT && (
					<button
						id="load-more"
						class="btn btn-primary"
						data-increment={INCREMENT}
					>
						Load More
					</button>
				)
			}
		</section>
	</main></Layout
>
<style lang="scss">
	.hero {
		background: url(../images/velewe-nature-reserve-nl.jpg);
		background-size: cover;
		background-position: center center;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100vw;
		height: 600px;
		margin-bottom: var(--spacing-12);
		@media (max-width: 1023px) {
			height: 300px;
		}
		h1 {
			font-size: xx-large;
			text-align: center;

			@media (min-width: 1024px) {
				font-size: xxx-large;
			}
		}
	}
	section {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		margin-bottom: 5rem;

		.article-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
			gap: 3rem;
			padding: 2rem;
			margin: 0 auto 5rem;

			@media (min-width: 1200px) {
				max-width: 1200px;
			}

			article,
			li {
				background: #8d89b7;
				border: 1px solid #bab7d5;
				border-radius: 8px;
				overflow: hidden;
				display: flex;
				flex-direction: column;

				.post-thumb {
					object-fit: cover;
					width: 100%;
					height: 200px;
				}

				.post-blurb {
					color: #000;
					padding: 1rem;

					h2 {
						font-size: 1.5rem;
						line-height: 1.25;
						padding: 0;
					}
				}
			}
		}
	}
	/* Utility class to hide posts */
	.article-card.is-hidden {
		display: none !important;
	}
	// .button-wrapper {
	// 	display: flex;
	// 	justify-content: center;
	// 	margin-top: 3rem;
	// }
	// #load-more-btn {
	// 	padding: 0.75rem 2rem;
	// 	font-size: 1rem;
	// 	cursor: pointer;
	// }
</style>
<script>
	const setupLoadMore = () => {
		const button = document.getElementById("load-more");
		if (!button) return;

		const defaultIncrement = window.innerWidth < 1024 ? "2" : "3";

		const increment = parseInt(
			button.getAttribute("data-increment") || defaultIncrement,
			10,
		);
		// Select all hidden cards
		const hiddenCards = Array.from(
			document.querySelectorAll(".article-card.is-hidden"),
		);
		let currentPointer = 0;

		button.addEventListener("click", () => {
			// Get the next batch of elements
			const nextBatch = hiddenCards.slice(
				currentPointer,
				currentPointer + increment,
			);

			nextBatch.forEach((card) => {
				card.classList.remove("is-hidden");
			});

			currentPointer += increment;

			// If no hidden cards remain, remove the button entirely
			if (currentPointer >= hiddenCards.length) {
				button.remove();
			}
		});
	};

	// Runs on page load (and handles Astro's View Transitions if you use them)
	setupLoadMore();
	document.addEventListener("astro:page-load", setupLoadMore);
</script>
